{
  "name": "parking-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "test:contracts": "vitest run shared/contracts",
    "test:routing": "vitest run shared/routing",
    "test:csv": "vitest run shared/csv",
    "test:builder": "vitest run client/builder client/map",
    "test:server": "vitest run server",
    "test:driver": "vitest run client/driver client/integration",
    "test:integration": "vitest run tests/integration",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external",
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1 --strictPort --port 5173\" \"tsx server/index.ts\"",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "esbuild": "0.24.2",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
